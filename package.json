{
  "name": "euro-remote-jobs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @euro-jobs/db generate",
    "db:migrate": "pnpm --filter @euro-jobs/db migrate:dev",
    "db:seed": "pnpm --filter @euro-jobs/db seed",
    "jobs:linkedin": "pnpm --filter @euro-jobs/worker run-once linkedin",
    "jobs:greenhouse": "pnpm --filter @euro-jobs/worker run-once greenhouse",
    "jobs:lever": "pnpm --filter @euro-jobs/worker run-once lever",
    "jobs:ashby": "pnpm --filter @euro-jobs/worker run-once ashby",
    "jobs:smartrecruiters": "pnpm --filter @euro-jobs/worker run-once smartrecruiters",
    "jobs:workable": "pnpm --filter @euro-jobs/worker run-once workable",
    "jobs:teamtailor": "pnpm --filter @euro-jobs/worker run-once teamtailor",
    "jobs:personio": "pnpm --filter @euro-jobs/worker run-once personio",
    "jobs:recruitee": "pnpm --filter @euro-jobs/worker run-once recruitee",
    "jobs:pinpoint": "pnpm --filter @euro-jobs/worker run-once pinpoint",
    "jobs:careerpage": "pnpm --filter @euro-jobs/worker run-once careerpage"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
